# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA suba o .env para o Git

# Banco de dados
# Formato: postgresql+asyncpg://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql+asyncpg://postgres:suasenha@localhost:5432/lumikids

# JWT — gere uma chave forte, ex: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (recuperação de senha) — opcional por enquanto
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua-senha-de-app-gmail
EMAIL_FROM=noreply@lumikids.app
