
# Banco de dados
# Formato: postgresql+asyncpg://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=

# JWT — gere uma chave forte, ex: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (recuperação de senha) — opcional por enquanto
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@lumikids.app
